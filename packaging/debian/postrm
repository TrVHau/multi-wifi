#!/bin/sh
set -e

case "$1" in
    purge)
        # Purge removes runtime directories and cache
        rm -rf /var/run/multiwifi /run/multiwifi || true
        rm -rf /etc/multiwifi || true
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # On ordinary remove or upgrade: NEVER delete user configuration
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        ;;
    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
