<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>MultiWiFi</vendor>
  <vendor_url>https://github.com/TrVHau/multi-wifi</vendor_url>
  <icon_name>network-wireless</icon_name>

  <action id="io.github.multiwifi.modify">
    <description>Configure MultiWiFi multi-path routing and uplinks</description>
    <message>Authentication is required to modify multi-path network uplinks and routing</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
